# Copie para .env e preencha. NUNCA versione o .env preenchido.
# Referência completa: docs/configuracao.md

# --- Servidor ---
PORT=3110
NODE_ENV=development
# Slug da casa padrão (ver shared/brands.ts): esportiva | bateu
NUXT_PUBLIC_APP_BRAND=bateu

# --- MongoDB (obrigatório: sem isso o app falha na primeira query) ---
MONGODB_URI=
MONGODB_DB=

# --- Painel admin ---
ADMIN_ALLOWED_EMAILS=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Web Push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@app.clubdabb2.online

# --- Lastlink (tokens do webhook) ---
LASTLINK_WEBHOOK_SECRET=
LASTLINK_WEBHOOK_SECRET_SEM_GALE=

# --- Catalogador (opcional; domínio já aceito na allowlist do grupoautoma) ---
# CATALOGADOR_REFERER=https://app.irmandadebacbo.com
